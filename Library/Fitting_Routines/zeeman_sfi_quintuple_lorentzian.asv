function funcOut = zeeman_sfi_quintuple_lorentzian(analyVar, indivDataset, avgDataset)
    
    %function that fits to a triple peaked Lorentzian
    %form = @(coeffs,x) coeffs(1) * exp(-(x-coeffs(6)-coeffs(2)).^2 ./ (2*coeffs(3)^2)) + coeffs(5) * exp(-(x-coeffs(6)).^2 ./ (2*coeffs(7)^2)) + coeffs(8) * exp(-(x-coeffs(6)+coeffs(2)).^2 ./ (2*coeffs(9)^2)) + coeffs(4);
    
    % coeffs = [A1 A2 A3 A4 A5,  sigma1 sigma2 sigma3 sigma4 sigma5,  Delta, x0, bg]
    form = @(coeffs,x) ...
    coeffs(1) .* ( coeffs(6)  ./ ( (x - (coeffs(12) - 2*coeffs(11))).^2 + coeffs(6).^2  ) ) + ...
    coeffs(2) .* ( coeffs(7)  ./ ( (x - (coeffs(12) - 1*coeffs(11))).^2 + coeffs(7).^2  ) ) + ...
    coeffs(3) .* ( coeffs(8)  ./ ( (x - (coeffs(12)             )).^2 + coeffs(8).^2  ) ) + ...
    coeffs(4) .* ( coeffs(9)  ./ ( (x - (coeffs(12) + 1*coeffs(11))).^2 + coeffs(9).^2  ) ) + ...
    coeffs(5) .* ( coeffs(10) ./ ( (x - (coeffs(12) + 2*coeffs(11))).^2 + coeffs(10).^2 ) ) + ...
    coeffs(13);


    indVarField = 'imagevcoAtom';
    depVarField = 'sfiIntegral_roi1_ratio';
    %depVarField = 'sfiIntegral';
    
    %% toggle saveVals on and off to save values to an external excel sheet
    %% added by npi
    saveVals = 0 ;
   
    function x0 = initial_guess(x, y)

        %Background
        bg = median(y(1:round(end*0.1))); 
        %y values minus background for other fitting
        y2 = y - bg;
        %Center Peak
        %x0 = sum(x.*y2)/sum(y2);
        x0 = 18624.2;
        %other peak locations
        %sort x values in ascending order for scans that are backwards
        [xs, idx] = sort(x);
        ys = y2(idx);
        [pks, locs] = findpeaks(ys, xs, ...
            'MinPeakProminence', 0.1*max(y2), ...
            'SortStr','descend');
        locs = sort(locs(1:3));
        %Delta = mean([x0 - locs(1), locs(3) - x0]);
        Delta = 1.92;

        %Amplitudes
        A1 = interp1(x,y2,x0,'linear','extrap');
        A1 = 0.06;
        A0 = interp1(x,y2,x0-Delta,'linear','extrap');
        A0 = 0.02;
        A2 = interp1(x,y2,x0+Delta,'linear','extrap');
        A2 = 0.04;
        A3 = A1;
        A4 = A0;
        %Widths
        sigma_est = sqrt(abs(sum((x-x0).^2 .* abs(y2)) / abs(sum(y2))));
        sigma_est = 0.15;
        %sigma_est = (max(x) - min(x)) / 20;
        x0 = [
            A0
            A1
            A2
            A3
            A4
            sigma_est
            sigma_est
            sigma_est
            sigma_est
            sigma_est
            Delta
            x0
            bg
        ];


    end

    %% options
    % the base_fit function is designed to be flexible, and can accept a
    % lot of different parameters to adjust 
    %%%%% Default Options %%%%%
%     options = struct(...
%         'DataPlotFunction', @defaultDataPlot,...
%         'AvgDataPlotFunction', @defaultAvgDataPlot,...
%         'FitLinePlotFunction', @defaultFitLinePlot,...
%         'AnnotateFunction', @defaultAnnotate,...
%         'IndivFitPlotFunction', @defaultIndivFitPlot,...
%         'PlotIndivFits' , true,...
%         'PlotAvgFits', true,...
%         'XAxisLabel', indVarField ,...
%         'YAxisLabel', depVarField,...
%         'FitLB', [],...
%         'FitUB', [],...
%         'FitOptions', struct('Display','off'),...
%         'PlotInitialGuess', true, ...
%         'InitialGuessPlotFunction', @defaultInitialGuessPlot,...
%         'PlotAll', true,...
%         'PlotAllAvgs', true, ...
%         'CoeffNames', {{}},...
%         'CoeffUnits', {{}},...
%         'YAxisScale', 'linear',...
%         'XAxisScale', 'linear');
    
% coeffs = [A1, A0, A2, sigma1, sigma0, sigma2, Delta, x0, bg]
    options = struct(...
        'PlotIndivFits', false,...
        'PlotAll', false,...
        'PlotAllAvgs', true,...
        'PlotInitialGuess', true,...
        'XAxisLabel', 'mmWave WindFreak Synth (MHz)' ,...
        'YAxisLabel', 'MCS Signal Ratio',...
        'CoeffNames', {{'Amplitude 1', 'Amplitude 2', 'Amplitude 3', 'Amplitude 4','Amplitude 5', 'FWHM 1', 'FWHM 2', 'FWHM 3', 'FWHM 4','FWHM 5', 'Zeeman Splitting', 'Center Peak','Offset'}},...
        'CoeffUnits', {{'','','','','','MHz','MHz','MHz','MHz','MHz','MHz','MHz','',''}},...
        'AnnotateFunction', @myAnnotate,...
        'FitTitle', 'Triple Lorentzian Fit',...
        'Statistics', 'gaussian');
    
    [xav,yav,yer,coefflist,coefflist_err] = base_fit(analyVar, indivDataset, avgDataset, form, indVarField, depVarField, @initial_guess, options)
    
    % if the saveVals is toggled on, save the values from the data
    
    if (saveVals == 1)
        filename = "MMWavePlotVals.xlsx";
        sheet    = "Sheet1";

        timeStr = strjoin(string(analyVar.timevectorAtom), ",");   % "1.2,3.4,5.6"
        plugInStr = strjoin(string(analyVar.plugInVec), ",");
        
        % Save several values to the array
        %first calculate the polarization purity in function too... (ctrl
        %+c ctrl + v from the myAnnotate function)
        % evaluating the integral from the fit coefficients.
        lineintegral1 = coefflist{1}(1)*coefflist{1}(4)*pi/2; % amp*FWHM*Pi/2 = lorentzian integral
        lineintegral2 = coefflist{1}(2)*coefflist{1}(5)*pi/2; % amp*FWHM*Pi/2 = lorentzian integral
        lineintegral3 = coefflist{1}(3)*coefflist{1}(6)*pi/2; % amp*FWHM*Pi/2 = lorentzian integral
        lineintegral_err1 = lineintegral1*(coefflist_err{1}(1)/coefflist{1}(1)+ coefflist{1}(4)/coefflist{1}(4));
        lineintegral_err2 = lineintegral2*(coefflist_err{1}(2)/coefflist{1}(2)+ coefflist{1}(5)/coefflist{1}(5));
        lineintegral_err3 = lineintegral3*(coefflist{1}(3)/coefflist{1}(3)+ coefflist{1}(6)/coefflist{1}(6));
    
        %Ratio of purity
        purityRatio = abs((lineintegral2)/(lineintegral2+lineintegral1+lineintegral3));
        purityError = purityRatio*(lineintegral_err1/lineintegral1+ ...
            lineintegral_err2/lineintegral3+ ...
            lineintegral_err3/lineintegral_err3);
        %%%
        % time stamp | plug in vector | Amplitude 1 | Amplitude 2 |
        % Amplitude 3 | FWHM 1 | FWHM 2 | FWHM 3 | Zeeman Splitting |
        % Center Peak | Offset | Purity Ratio | first file name
        row = {timeStr, plugInStr, coefflist{1}(1), coefflist{1}(2), coefflist{1}(3), coefflist{1}(4), coefflist{1}(5), coefflist{1}(6), coefflist{1}(7), coefflist{1}(8), coefflist{1}(9), purityRatio,'58 s', '58 d', indivDataset{1,1}.fileAtom{1}};  % cell row
        
        if isfile(filename)
            C = readcell(filename, "Sheet", sheet);
            nextRow = size(C,1) + 1;
        else
            nextRow = 1;
        end
        range = "A" + nextRow;
        writecell(row, filename, "Sheet", sheet, "Range", range);
    end 

    funcOut.analyVar = analyVar;
    funcOut.indivDataset = indivDataset;
    funcOut.avgDataset = avgDataset;

end
function h = myplot(x,y,analyVar,i)
    h = plot(x,y,...
        'LineStyle','none',...
        'Marker', 'o',...
        'MarkerSize', analyVar.markerSize,...
        'MarkerFaceColor', analyVar.COLORS(i,:),...
        'MarkerEdgeColor', 'none',...
        'Color', analyVar.COLORS(i,:));
end

function h = myerrorbar(x,y,yerr,analyVar,i)
    h = errorbar(x,y,yerr,...
        'LineStyle','none',...
        'Marker', 'o',...
        'MarkerSize', analyVar.markerSize,...
        'MarkerFaceColor', analyVar.COLORS(i,:),...
        'MarkerEdgeColor', 'none',...
        'Color', analyVar.COLORS(i,:));
end

function h = myfitplot(x,y,analyVar,i)
    h = plot(x,y,...
        'LineStyle','-',...
        'Marker', 'none',...
        'MarkerSize', analyVar.markerSize,...
        'MarkerFaceColor', analyVar.COLORS(i,:),...
        'MarkerEdgeColor', 'none',...
        'Color', analyVar.COLORS(i,:),...
        'LineWidth',5);
end

function an = myAnnotate(coeffs, err, coeffNames, coeffUnits)
    
    % convert the HWHM to FWHM
    coeffs(6) = coeffs(6)*2;
    coeffs(7) = coeffs(7)*2;
    coeffs(8) = coeffs(8)*2;
    coeffs(9) = coeffs(9)*2;
    coeffs(10) = coeffs(10)*2;
    
    dim = [.6 .5 .3 .3];

    % lineintegral_err1 = lineintegral1*(err(1)/coeffs(1));
    % lineintegral_err2 = lineintegral2*(err(2)/coeffs(2));
    % lineintegral_err3 = lineintegral3*(err(3)/coeffs(3));
    % lineintegral_err4 = lineintegral4*(err(4)/coeffs(4));
    % lineintegral_err5 = lineintegral5*(err(5)/coeffs(5));
    % %Ratio of purity
    % purityRatio = 1 - abs((lineintegral1 + lineintegral5)/(lineintegral2+lineintegral1+lineintegral3 + lineintegral4 + lineintegral5));
    % purityError = purityRatio*(lineintegral_err1/lineintegral1+ ...
    %     lineintegral_err2/lineintegral3+ ...
    %     lineintegral_err3/lineintegral_err3 + ...
    %     lineintegral_err4/lineintegral_err4 + ...
    %     lineintegral_err5/lineintegral_err5);
    
    
    %Fitting data from scans to the field amplitude equations
    %Using ratios of each othe peaks
    
    denominator = sqrt(coeffs(1)^2 + coeffs(2)^2 + coeffs(3)^2 + coeffs(4)^2 + coeffs(5)^2);
    d1 = coeffs(1) / denominator; %left most peak
    d2 = coeffs(2) / denominator;
    d3 = coeffs(3) / denominator; %Center Peak
    d4 = coeffs(4) / denominator;
    d5 = coeffs(5) / denominator; %Right most peak

    Error1 = sqrt( ((coeffs(2)^2+coeffs(3)^2+coeffs(4)^2+coeffs(5)^2)^2*err(1)^2 + ...
        (coeffs(1)*coeffs(2)*err(2))^2 + (coeffs(1)*coeffs(3)*err(3))^2 + ...
        (coeffs(1)*coeffs(4)*err(4))^2 + (coeffs(1)*coeffs(5)*err(5))^2 ) / ...
        (coeffs(1)^2 + coeffs(2)^2 + coeffs(3)^2 + coeffs(4)^2 + coeffs(5)^2)^3 ) * d1;

    Error2 = sqrt( ((coeffs(1)^2+coeffs(3)^2+coeffs(4)^2+coeffs(5)^2)^2*err(2)^2 + ...
        (coeffs(2)*coeffs(1)*err(1))^2 + (coeffs(2)*coeffs(3)*err(3))^2 + ...
        (coeffs(2)*coeffs(4)*err(4))^2 + (coeffs(2)*coeffs(5)*err(5))^2 ) / ...
        (coeffs(1)^2 + coeffs(2)^2 + coeffs(3)^2 + coeffs(4)^2 + coeffs(5)^2)^3 ) * d2;

    Error3 = sqrt( ((coeffs(1)^2+coeffs(2)^2+coeffs(4)^2+coeffs(5)^2)^2*err(3)^2 + ...
        (coeffs(3)*coeffs(1)*err(1))^2 + (coeffs(3)*coeffs(2)*err(2))^2 + ...
        (coeffs(3)*coeffs(4)*err(4))^2 + (coeffs(3)*coeffs(5)*err(5))^2 ) / ...
        (coeffs(1)^2 + coeffs(2)^2 + coeffs(3)^2 + coeffs(4)^2 + coeffs(5)^2)^3 ) * d3;

    Error4 = sqrt( ((coeffs(1)^2+coeffs(2)^2+coeffs(3)^2+coeffs(5)^2)^2*err(4)^2 + ...
        (coeffs(4)*coeffs(1)*err(1))^2 + (coeffs(4)*coeffs(2)*err(2))^2 + ...
        (coeffs(4)*coeffs(3)*err(3))^2 + (coeffs(4)*coeffs(5)*err(5))^2 ) / ...
        (coeffs(1)^2 + coeffs(2)^2 + coeffs(3)^2 + coeffs(4)^2 + coeffs(5)^2)^3 ) * d4;

    Error5 = sqrt( ((coeffs(1)^2+coeffs(2)^2+coeffs(3)^2+coeffs(4)^2)^2*err(5)^2 + ...
        (coeffs(5)*coeffs(1)*err(1))^2 + (coeffs(5)*coeffs(2)*err(2))^2 + ...
        (coeffs(5)*coeffs(3)*err(3))^2 + (coeffs(5)*coeffs(4)*err(4))^2 ) / ...
        (coeffs(1)^2 + coeffs(2)^2 + coeffs(3)^2 + coeffs(4)^2 + coeffs(5)^2)^3 ) * d5;
    

    % Data values (measured peak ratios of peak_i / sum of total peaks area)
    disp('Data:');
    data = [d1; d2; d3; d4; d5; 1] 

    % Measurement errors (standard deviations)
    disp('Errors:');
    errors = [Error1; Error2; Error3; Error4; Error5; .01]  % Corresponding uncertainties
    
    % Initial guess for parameters
    initial_guess = [sqrt(1/3) sqrt(1/3) sqrt(1/3) 0 0 0];

    % Options for Jacobian output needed for error calculation of the
    % fitted parameters
    options = optimoptions('lsqnonlin', 'Display', 'iter');
    
    disp('Initial Difference:');
    residuals(initial_guess,data,errors)

    %%Trying montecarlo error propagation since number of equations equals
    %%number of parameters and blows up error propagation in Jacobian me
    Nsamples = 1000;

    params_MC = zeros(Nsamples,length(initial_guess));
    
    for i = 1:Nsamples
    
        data_perturbed = data + errors .* randn(size(data));
    
        params_MC(i,:) = lsqnonlin(@(p) residuals(p,data_perturbed,errors),initial_guess);
    
    end
    
    param_mean = mean(params_MC);
    param_std  = std(params_MC);
    
    [params_est, resnorm, ~, ~, ~, ~, J] = lsqnonlin(@(p) residuals(p,data,errors), initial_guess, [],[],options);

    disp(J)

    % Compute the covariance matrix (approximation)
    covariance_matrix = inv(J' * J) * (resnorm / (length(data) - length(params_est)))
    
    % Standard deviations (errors) of the parameters
    paramsErr = sqrt(diag(covariance_matrix));
    
    disp('Estimated Parameters:');
    disp(params_est);
    
    disp('Parameter Uncertainties (Standard Deviations):');
    disp(paramsErr);

    purityRatio = params_est(1) / sqrt( params_est(1)^2 + params_est(2)^2 + params_est(3)^2);
    purityError = sqrt( ((params_est(2)^2+params_est(3)^2)^2*paramsErr(1)^2 + (params_est(1)*params_est(2)*paramsErr(2))^2 + (params_est(1)*params_est(3)*paramsErr(3))^2 ) / ...
        (params_est(1)^2 + params_est(2)^2 + params_est(3)^2)^3 ) * purityRatio;


    %%%
    if isempty(coeffNames)
        for i = 1:numel(coeffs)
            coeffNames{i} = ['Coeff ', num2str(i)];
        end
    end
    
    if isempty(coeffUnits)
        for i = 1:numel(coeffs)
            coeffUnits{i} = '';
        end
    end
    temp = .001;
    strs = cell(numel(coeffs),1);

    disp(strs)
    for i = 1:numel(coeffs)
        if i < numel(coeffs)
            strs{i} = [coeffNames{i}, ': ', unc_string(coeffs(i),err(i)),...
                ' ', coeffUnits{i}, newline];
        else
            strs{i} = [coeffNames{i}, ': ', unc_string(coeffs(i),err(i)),...
                ' ', coeffUnits{i}];
        end
    end
    %%% adding line integral string.
    strs{i+1} = [newline,'PurityPiRatio', ': ', unc_string(purityRatio,purityError)];
    
    an = annotation('textbox', dim, 'String', strjoin(strs),...
        'FitBoxToText', 'on', 'BackgroundColor', 'white');
end


function r = residuals(params, data, errors)
    
    p1 = params(1); % E_0
    p2 = params(2); % E_-
    p3 = params(3); % E_+
    p4 = params(4); % phi_(+0) "difference of plus and 0"
    p5 = params(5); % phi_(-0)
    p6 = params(6); % phi_(-+)



    denominator = sqrt( p2^4 + p3^4 + p1^2*p1^2*(1 + cos(2*p4)) + p2^2*p1^2*(1 + cos(2*p5)) + (2/3)*p1^4 + ...
        (1/3)*p2^2*p3^2*(1 + cos(2*p6)) +(4/3)*p1^2*p2*p3*cos(p6) );
    
    % six nonlinear equations 
    % (left most peak, peak 2, center peak, peak 4, right most peak,
    % constraint)
    f1 = p2^2 / denominator;
    f2 = sqrt(2)*p1*p2*cos(p5) / denominator;
    f3 = sqrt(2)*(p1^2 + p2*p3*cos(p6)) / denominator;
    f4 = sqrt(2)*p1*p3*cos(p5) / denominator;
    f5 = p2^3 / denominator;
    f6 = p1^2 + p2^2 + p3^2;
    
    model = [f1; f2; f3; f4; f5; f6];

    % Weighted residuals
    r = (model - data) ./ errors;

end